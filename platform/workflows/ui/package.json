{
  "name": "@kickside/workflows-ui",
  "version": "0.1.0",
  "specification": "wippy-component-1.0",
  "title": "KickSide Workflow Builder",
  "description": "Visual Workflow builder for canonical registry-declared Blocks.",
  "browser": "dist/index.js",
  "files": [
    "dist/",
    "src/",
    "package.json"
  ],
  "type": "module",
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@kickside/ui-kit": "*",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.1",
    "@wippy-fe/shared": "*",
    "@wippy-fe/theme": "*",
    "@wippy-fe/webcomponent-core": "*",
    "@wippy-fe/webcomponent-vue": "*",
    "primevue": "4.5.5"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "@wippy-fe/proxy": "*",
    "@wippy-fe/vite-plugin": "*",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.12"
  },
  "peerDependencies": {
    "@wippy-fe/proxy": "*",
    "vue": "^3.5.0"
  },
  "wippy": {
    "description": "Builds Workflow-owned web components served from /kickside-workflows: kickside-workflow-builder lists and edits Workflows from its route prop; kickside-workflow-setup creates a Workflow in a host-owned popup; kickside-workflow-embed runs a published Workflow in place; and kickside-component-workflows composes component defaults and event Automations. Block providers own their configuration components. Trigger bindings are created by the generic Automation component.",
    "tagName": "kickside-workflow-builder",
    "type": "component",
    "props": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string",
          "default": "",
          "description": "Empty or '/' shows the Workflow list; '/{id}' opens that Workflow on the canvas."
        },
        "mode": {
          "type": "string",
          "default": "",
          "description": "'preview' renders the compact glance card for the workspace preview panel; anything else is the full builder."
        }
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "navigate": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        }
      }
    },
    "scripts": {
      "build": "build"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "watch": "vite build --watch",
    "type-check": "vue-tsc --build --force",
    "prebuild": "node ../scripts/generate-vocabulary.mjs --check",
    "pretest": "node ../scripts/generate-vocabulary.mjs --check",
    "pretype-check": "node ../scripts/generate-vocabulary.mjs --check",
    "test": "vitest run"
  },
  "workspaces": [
    "./.wippy/npm/@*/*"
  ]
}
