{
  "repository": "crm",
  "checks": [
    [
      "make",
      "check-deps"
    ],
    [
      "make",
      "check-architecture"
    ],
    [
      "python3",
      "-B",
      ".github/scripts/test_release_baseline.py"
    ],
    [
      "node",
      ".github/scripts/test_release_dry_run.cjs"
    ],
    [
      "python3",
      "-B",
      ".github/scripts/test_packaging.py"
    ],
    [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests",
      "-p",
      "test_harness_preparation.py"
    ]
  ],
  "modules": {
    ".": {
      "path": ".",
      "organization": "kickside",
      "module": "crm",
      "type": "plugin",
      "visibility": "public",
      "embed": [
        "kickside.crm.surface:fs"
      ],
      "targets": [
        "build",
        "lint",
        "test",
        "check-deps",
        "check-architecture",
        "test-postgres",
        "verify",
        "dry-run",
        "publish"
      ],
      "harness": "test",
      "profiles": [
        "postgres"
      ],
      "pg_database": "kickside_test_crm",
      "extra_tests": [],
      "test_runner": "crm"
    }
  }
}
