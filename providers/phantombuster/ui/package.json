{
  "name": "@kickside/phantombuster-ui",
  "version": "0.1.0",
  "specification": "wippy-component-1.0",
  "title": "KickSide PhantomBuster Picker",
  "description": "Trait configuration picker for selecting a PhantomBuster connection.",
  "browser": "dist/index.js",
  "files": [
    "dist/",
    "src/",
    "package.json"
  ],
  "type": "module",
  "dependencies": {
    "@wippy-fe/theme": "*",
    "@wippy-fe/webcomponent-core": "*",
    "@wippy-fe/webcomponent-vue": "*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "@wippy-fe/proxy": "*",
    "@wippy-fe/vite-plugin": "*",
    "happy-dom": "^20.10.6",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "@wippy-fe/proxy": "*",
    "vue": "^3.5.0"
  },
  "wippy": {
    "description": "Render the KickSide PhantomBuster Picker module-owned Wippy surface inside a host application. Load it by its registered custom-element tag, pass only the documented properties when selecting or editing a resource, and listen for its typed events when the host must navigate, refresh, or accept a value. The component uses the injected Wippy proxy for authenticated APIs and remains isolated inside its Shadow DOM.",
    "tagName": "kickside-phantombuster-picker",
    "type": "component",
    "props": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "default": {},
          "description": "Trait context with optional connection_id.",
          "properties": {
            "connection_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "config-changed": {
          "type": "object",
          "properties": {
            "connection_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "scripts": {
      "build": "build"
    }
  },
  "scripts": {
    "build": "vite build --outDir ../static",
    "dev": "vite build --watch --outDir ../static",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit"
  }
}
