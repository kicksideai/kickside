{
  "name": "@kickside/github-ui",
  "version": "0.1.0",
  "specification": "wippy-component-1.0",
  "title": "KickSide GitHub Connect",
  "description": "Connect web component (kickside-github-connect) for the GitHub provider: OAuth App or stored personal access token.",
  "browser": "dist/index.js",
  "files": [
    "dist/",
    "src/",
    "package.json"
  ],
  "type": "module",
  "dependencies": {
    "@wippy-fe/theme": "*",
    "@wippy-fe/webcomponent-core": "*",
    "@wippy-fe/webcomponent-vue": "*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "@wippy-fe/proxy": "*",
    "@wippy-fe/vite-plugin": "*",
    "happy-dom": "^20.10.6",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "@wippy-fe/proxy": "*",
    "vue": "^3.5.0"
  },
  "wippy": {
    "tagName": "kickside-github-connect",
    "type": "component",
    "props": {
      "type": "object",
      "properties": {
        "provider-id": {
          "type": "string",
          "description": "Provider key (github)",
          "default": ""
        },
        "component-id": {
          "type": "string",
          "description": "Existing connection id when reauthorizing",
          "default": ""
        }
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "connection-saved": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean"
            },
            "error": {
              "type": "string"
            }
          },
          "description": "Emitted after a stored-PAT connection is created."
        },
        "oauth-result": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean"
            },
            "error": {
              "type": "string"
            }
          },
          "description": "Emitted after the OAuth popup completes."
        }
      }
    },
    "scripts": {
      "build": "build"
    },
    "description": "Render the KickSide GitHub Connect module-owned Wippy surface inside a host application. Load it by its registered custom-element tag, pass only the documented properties when selecting or editing a resource, and listen for its typed events when the host must navigate, refresh, or accept a value. The component uses the injected Wippy proxy for authenticated APIs and remains isolated inside its Shadow DOM."
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit"
  }
}
