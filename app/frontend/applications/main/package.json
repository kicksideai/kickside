{
  "name": "@wippy/app-main",
  "version": "1.0.0",
  "specification": "wippy-component-1.0",
  "title": "KickSide",
  "description": "KickSide application shell",
  "files": [
    "dist/",
    "src/",
    "package.json"
  ],
  "browser": "dist/app.js",
  "wippy": {
    "type": "page",
    "renderEngine": "iframe",
    "title": "KickSide",
    "icon": "tabler:home",
    "path": "dist/app.html",
    "proxy": {
      "enabled": true,
      "injections": {
        "css": {
          "themeConfig": true,
          "iframe": true,
          "primevue": true,
          "markdown": false,
          "customCss": true,
          "customVariables": true
        },
        "tailwindConfig": false,
        "resizeObserver": false,
        "preventLinkClicks": false,
        "iconifyIcons": false,
        "errorCapture": true
      }
    },
    "scripts": {
      "build": "build",
      "debug": "build:debug"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:debug": "vite build --mode development",
    "dev": "vite build --watch",
    "test": "vitest run --environment happy-dom",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "@kickside/ui-kit": "*",
    "@iconify-json/tabler": "*",
    "@wippy-fe/layout": "*",
    "@wippy-fe/router": "*",
    "@wippy-fe/shared": "*",
    "@wippy-fe/theme": "*",
    "@fontsource-variable/inter": "*",
    "@fontsource-variable/outfit": "*",
    "@fontsource-variable/jetbrains-mono": "*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "@wippy-fe/types-global-proxy": "*",
    "@wippy-fe/vite-plugin": "*",
    "autoprefixer": "^10.4.0",
    "es-module-lexer": "*",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.0",
    "primevue": "4.5.5",
    "tailwindcss": "3",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.8",
    "yaml": "*"
  },
  "peerDependencies": {
    "@iconify/vue": "^5.0.0",
    "@wippy-fe/proxy": "*",
    "axios": "^1.0.0",
    "luxon": "^3.5.0",
    "pinia": "^2.1.0",
    "primevue": "^4.3.3",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "workspaces": [
    "./.wippy/npm/@*/*"
  ]
}
