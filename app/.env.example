PUBLIC_API_URL=http://localhost:8085

# Generate before first run:
#   printf 'ENCRYPTION_KEY=%s\n' "$(openssl rand -hex 32)" >> .env

# Optional bootstrap admin credentials. Use .env for local development and a
# secret-managed env source in shared deployments. If omitted, KickSide users
# generates random first-boot credentials and prints them in the boot logs for
# local setup.
# KICKSIDE_USERS_DEFAULT_ADMIN_EMAIL=admin@example.com
# KICKSIDE_USERS_DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
